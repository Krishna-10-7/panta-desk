# Keep this key on the server. Never put it in public/ or commit it.
PANTA_API_KEY=
# true forces illustrative sample data, even when a key is present.
# Set false after adding your key to use Panta's production read endpoints.
# With neither a key nor this setting, the server defaults to demo mode.
PANTA_DEMO=true
# Keep the local default. On Render, explicitly set HOST=0.0.0.0.
HOST=127.0.0.1
PORT=4173
